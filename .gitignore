# Publication allowlist. Local inputs and new root directories stay private.
/*
!/.gitignore
!/.gitattributes
!/readme.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/requirements.txt
!/signing.example.json
!/licenses/
/licenses/*
!/licenses/NFSMW-Recompiled-Mobile.txt
!/dependencies-dxvk.json
!/dependencies-textures.json
!/dependencies-turnip.json
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/update-manifest.yml

!/android/
/android/**
!/android/**/
!/android/**/*.c
!/android/**/*.cpp
!/android/**/*.h
!/android/**/*.inc
!/android/**/*.java
!/android/**/*.xml
!/android/port.json
!/android/launcher/README.md
!/android/launcher/tools/
!/android/launcher/tools/*.py
!/android/launcher/tests/
!/android/launcher/tests/**
!/android/launcher/native/
!/android/launcher/native/**

!/config/
/config/*
!/config/*.json

!/generated/
/generated/*
!/generated/dispatch.c
!/generated/modules.inc
!/generated/setjmp_continuations.c
!/generated/crashday/
!/generated/msvcr120/
!/generated/msvcp120/
!/generated/msvcrt/
!/generated/d3dx9/
!/generated/d3dx9_31/
!/generated/d3dcompiler/
!/generated/d3dcompiler41/
/generated/*/*
!/generated/*/*.c
!/generated/*/*.h
!/generated/*/report.json

!/tools/
/tools/*
!/tools/*.py
!/tools/tests/
!/tools/tests/**

!/reference/
/reference/*
!/reference/pcrecomp/
/reference/pcrecomp/*
!/reference/pcrecomp/LICENSE
!/reference/pcrecomp/tools/
!/reference/pcrecomp/tools/**
!/reference/mojoshader/
!/reference/mojoshader/**
!/reference/dlmalloc/
!/reference/dlmalloc/**
!/reference/astcenc/
!/reference/astcenc/**
!/reference/etcpak/
!/reference/etcpak/**
!/reference/dxvk/
!/reference/dxvk/**

# Defense in depth; none of these are source publication inputs.
**/.git/
**/__pycache__/
**/.gradle/
**/build/
**/.idea/
**/.vscode/
**/.claude/
